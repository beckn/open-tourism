{
  "@context": {
    "@import": "https://schema.nfh.global/core/v2/context.jsonld#generalised",
    "schema": "https://schema.org/",
    "ar": "https://schema.nfh.global/AccommodationResource#",
    "acr": "https://schema.nfh.global/AccommodationRate#",
    "ares": "https://schema.nfh.global/AccommodationReservation#",
    "ct": "https://schema.nfh.global/CancellationTerms#",
    "gm": "https://schema.nfh.global/GuestManifest#",

    "AccommodationResource": "ar:AccommodationResource",
    "AccommodationRate": "acr:AccommodationRate",
    "AccommodationReservation": "ares:AccommodationReservation",
    "CancellationTerms": "ct:CancellationTerms",
    "GuestManifest": "gm:GuestManifest",

    "localPropertyId": { "@id": "ar:localPropertyId" },
    "propertyName": { "@id": "schema:name" },
    "starRating": { "@id": "schema:starRating" },
    "propertyAddress": { "@id": "schema:streetAddress" },
    "propertyDescription": { "@id": "schema:description" },
    "propertyImages": { "@id": "ar:propertyImages", "@container": "@list" },
    "thumbnailUrl": { "@id": "schema:thumbnailUrl" },
    "fullUrl": { "@id": "schema:contentUrl" },
    "propertyAmenities": { "@id": "ar:propertyAmenities", "@container": "@list" },
    "unitAmenities": { "@id": "ar:unitAmenities", "@container": "@list" },
    "contactPhone": { "@id": "schema:telephone" },
    "contactEmail": { "@id": "schema:email" },
    "contactWebsite": { "@id": "schema:url" },

    "unitCategory": { "@id": "acr:unitCategory" },
    "unitTypeDescription": { "@id": "acr:unitTypeDescription" },
    "mealBasisCode": { "@id": "acr:mealBasisCode" },
    "mealBasisLabel": { "@id": "acr:mealBasisLabel" },
    "totalRateAmount": { "@id": "schema:price" },
    "rateCurrency": { "@id": "schema:priceCurrency" },
    "nightlyRates": { "@id": "acr:nightlyRates", "@container": "@list" },
    "date": { "@id": "acr:date" },
    "dayOfWeek": { "@id": "schema:dayOfWeek" },
    "nightlyRate": { "@id": "acr:nightlyRate" },
    "refundable": { "@id": "acr:refundable" },
    "adultsCount": { "@id": "acr:adultsCount" },
    "childrenCount": { "@id": "acr:childrenCount" },
    "childAges": { "@id": "acr:childAges", "@container": "@list" },
    "unitCount": { "@id": "acr:unitCount" },
    "available": { "@id": "acr:available" },
    "rateNote": { "@id": "acr:rateNote" },
    "indicativeCancellationWindows": { "@id": "acr:indicativeCancellationWindows", "@container": "@list" },
    "windowStart": { "@id": "acr:windowStart" },
    "windowEnd": { "@id": "acr:windowEnd" },
    "chargeAmount": { "@id": "acr:chargeAmount" },
    "sessionExpiresAt": { "@id": "acr:sessionExpiresAt" },

    "bookingReference": { "@id": "ares:bookingReference" },
    "agentReference": { "@id": "ares:agentReference" },
    "networkConfirmationRef": { "@id": "ares:networkConfirmationRef" },
    "propertyConfirmationRef": { "@id": "ares:propertyConfirmationRef" },
    "reservationStatus": { "@id": "ares:reservationStatus" },
    "bookingDate": { "@id": "schema:bookingTime" },
    "cancellationDeadline": { "@id": "ares:cancellationDeadline" },
    "totalChargeAmount": { "@id": "schema:price" },
    "grossAmount": { "@id": "ares:grossAmount" },
    "chargeCurrency": { "@id": "schema:priceCurrency" },
    "leadSalutation": { "@id": "schema:honorificPrefix" },
    "leadFirstName": { "@id": "schema:givenName" },
    "leadLastName": { "@id": "schema:familyName" },
    "propertyPhone": { "@id": "schema:telephone" },
    "propertyRating": { "@id": "schema:starRating" },
    "propertyCountry": { "@id": "schema:addressCountry" },
    "propertyCity": { "@id": "schema:addressLocality" },
    "checkInDate": { "@id": "schema:checkinTime" },
    "checkOutDate": { "@id": "schema:checkoutTime" },
    "selectedNights": { "@id": "ares:selectedNights" },
    "totalRooms": { "@id": "ares:totalRooms" },
    "totalAdults": { "@id": "ares:totalAdults" },
    "totalChildren": { "@id": "ares:totalChildren" },
    "roomDetail": { "@id": "ares:roomDetail", "@container": "@list" },
    "roomTypeDescription": { "@id": "ares:roomTypeDescription" },
    "numberOfRooms": { "@id": "ares:numberOfRooms" },
    "roomType": { "@id": "ares:roomType" },
    "specialRemark": { "@id": "ares:specialRemark" },
    "contractComments": { "@id": "ares:contractComments" },
    "cancellationPolicyText": { "@id": "ares:cancellationPolicyText" },
    "cancellationDate": { "@id": "ares:cancellationDate" },
    "cancellationChargeAmount": { "@id": "ares:cancellationChargeAmount" },
    "cancellationChargeCurrency": { "@id": "ares:cancellationChargeCurrency" },
    "refundAmount": { "@id": "ares:refundAmount" },
    "refundCurrency": { "@id": "ares:refundCurrency" },

    "verifiedTotalAmount": { "@id": "ct:verifiedTotalAmount" },
    "verifiedTotalCurrency": { "@id": "ct:verifiedTotalCurrency" },
    "contractComment": { "@id": "ct:contractComment" },
    "bookingPermitted": { "@id": "ct:bookingPermitted" },
    "unitSoldOut": { "@id": "ct:unitSoldOut" },
    "statusMessage": { "@id": "ct:statusMessage" },
    "cancellationHours": { "@id": "ct:cancellationHours" },
    "appliedChargeAmount": { "@id": "ct:appliedChargeAmount" },
    "refundabilityLabel": { "@id": "ct:refundabilityLabel" },
    "bindingCancellationWindows": { "@id": "ct:bindingCancellationWindows", "@container": "@list" },
    "amendmentTerms": { "@id": "ct:amendmentTerms" },
    "noShowTerms": { "@id": "ct:noShowTerms" },
    "priceChanged": { "@id": "ct:priceChanged" },
    "priceMovementAmount": { "@id": "ct:priceMovementAmount" },
    "cancellationChargeQuote": { "@id": "ct:cancellationChargeQuote" },
    "allowCancel": { "@id": "ct:allowCancel" },
    "quoteMessage": { "@id": "ct:quoteMessage" },

    "passengers": { "@id": "gm:passengers", "@container": "@list" },
    "salutation": { "@id": "schema:honorificPrefix" },
    "firstName": { "@id": "schema:givenName" },
    "lastName": { "@id": "schema:familyName" },
    "passengerType": { "@id": "gm:passengerType" },
    "age": { "@id": "schema:age" },
    "specialRequest": { "@id": "gm:specialRequest" },
    "specialRequestDisclaimer": { "@id": "gm:specialRequestDisclaimer" },
    "consentArtifact": { "@id": "gm:consentArtifact" },
    "consentId": { "@id": "gm:consentId" },
    "subject": { "@id": "gm:consentSubject" },
    "purpose": { "@id": "gm:consentPurpose" },
    "scope": { "@id": "gm:consentScope", "@container": "@list" },
    "grantedAt": { "@id": "gm:grantedAt" },
    "expiresAt": { "@id": "gm:expiresAt" },
    "mechanism": { "@id": "gm:consentMechanism" },
    "mediator": { "@id": "gm:consentMediator" }
  }
}
